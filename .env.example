# Supabase（プロジェクト設定 > API から取得）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic（Claude API）
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI（瞬間英作文の読み上げ = クラウドTTS。未設定ならブラウザ標準の読み上げにフォールバック）
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Supabase service role（サーバ専用。瞬間英作文のTTS音声を Storage に保存するのに使う）
# ダッシュボード > Project Settings > API の service_role key。クライアントには絶対に露出しない。
SUPABASE_SERVICE_ROLE_KEY=
